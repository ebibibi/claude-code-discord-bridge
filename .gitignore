# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environment (uv manages this)
.venv/

# Environment variables
# .env.* too: operators leave dated backups (.env.bak-2026-01-01) next to the
# real file, and those hold a live bot token. Ignoring only `.env` means one
# `git add -A` stages a working credential. `.env.example` is the tracked
# template and is re-included explicitly.
.env
.env.*
!.env.example

# Database
data/

# User-specific config
context_links.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
.coverage
htmlcov/
.pytest_cache/

# Logs (bot-generated, e.g. the optional rotating file log handler)
logs/
